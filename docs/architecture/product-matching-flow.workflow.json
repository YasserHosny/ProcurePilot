  "cards": [
    {
      "dot": "rose",
      "title": "When a line goes to review",
      "items": [
        "no_candidate: nothing found",
        "close_candidates: top two within 0.05",
        "fuzzy_match_review: similarity-only match that would pass but fuzzy auto-accept is off",
        "low_confidence: top candidate below 0.92"
      ]
    },
    {
      "dot": "cyan",
      "title": "Learning",
      "items": [
        "A human decision stores the line text as an alias for that product",
        "The next quote with the same text is an exact alias hit and auto-accepts",
        "Bulk confirm accepts exact-name matches from the queue in one action"
      ]
    },
    {
      "dot": "slate",
      "title": "Not shown",
      "items": [
        "Embeddings use a stub hash model unless MATCHING_EMBEDDING_PROVIDER_MODE=bedrock",
        "POS and accounting have their own matching services"
      ]
    }
