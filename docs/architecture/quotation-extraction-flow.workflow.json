  "cards": [
    { "dot": "cyan", "title": "How a quote enters", "items": [
      "Web upload creates a pending quotation; extraction starts on POST /extract",
      "Email and mobile capture create quotation + job, then enqueue after commit",
      "A failed Redis enqueue stays retryable via retry_extraction or the requeue_extraction CLI"
    ] },
    { "dot": "amber", "title": "Review reasons (in order)", "items": [
      "read_failure · currency_unresolved · date_unparsed · merged_line_items",
      "line_count_mismatch · arithmetic_mismatch · total_unverified",
      "low_confidence (below 0.85) · no_supplier_match"
    ] },
    { "dot": "rose", "title": "Never guessed", "items": [
      "No evidenced currency → home currency stored only as a suggestion",
      "Unparsed dates keep raw evidence; canonical columns stay NULL",
      "Refused is reserved for unreadable documents or a process failure"
    ] }
  ]
