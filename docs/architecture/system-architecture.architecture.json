  "cards": [
    {
      "dot": "cyan",
      "title": "Tenancy",
      "items": [
        "The API verifies the Supabase JWT and takes the tenant from its claim",
        "Postgres row-level security enforces tenant isolation on every table",
        "Workers connect to Postgres directly and scope every query by the job's tenant_id"
      ]
    },
    {
      "dot": "amber",
      "title": "Queues",
      "items": [
        "Redis/RQ carries extraction and basket-split jobs; the API reaches Redis over the workers app's Anycast IP",
        "Inbound email goes Mailgun → API webhook → ingestion_jobs table, which the ingestion worker polls; guardrail evaluation uses the same table"
      ]
    },
    {
      "dot": "slate",
      "title": "Not shown",
      "items": [
        "Workers also read and write Postgres directly",
        "Export, webhook, offer-refresh and catalogue-refresh workers have docker-compose services; digest, report and accounting/POS sync workers have none, and the runbook lists no hosted container for any of them",
        "Accounting/POS integrations, push notifications and the analyst's Bedrock calls"
      ]
    }
  ]
