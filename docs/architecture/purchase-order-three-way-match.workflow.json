  "cards": [
    {
      "dot": "cyan",
      "title": "How a bill finds its order",
      "items": [
        "Candidate orders for the bill's matched supplier; none → invoice_without_order, several → ambiguous_order",
        "Missing confirmation or receipt is a discrepancy; the result is partial or unavailable",
        "Quantity, price, currency and over-billing are checked line by line within tolerance"
      ]
    },
    {
      "dot": "amber",
      "title": "Order status in practice",
      "items": [
        "The code sets draft, submitted and cancelled only",
        "confirmed, partially_received, received and closed exist in the enum but nothing sets them yet",
        "Cancel is refused once an order is received or closed"
      ]
    },
    {
      "dot": "slate",
      "title": "Evidence only",
      "items": [
        "Orders are internal records; nothing is sent to a supplier or provider",
        "Confirmations and receipts are recorded by people and cannot exceed the order"
      ]
    }
  ]
