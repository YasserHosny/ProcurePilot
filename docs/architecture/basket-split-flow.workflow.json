  "cards": [
    {
      "dot": "cyan",
      "title": "Attempt fence",
      "items": [
        "Each attempt's created_at is its token; a retry resets it",
        "The worker claims and writes only if the token still matches",
        "A late delivery from an expired attempt cannot overwrite a retry"
      ]
    },
    {
      "dot": "rose",
      "title": "When a job counts as stuck",
      "items": [
        "Queued with no RQ worker on the queue past the stall window → optimiser_unavailable",
        "Queued or running past the expiry window → optimiser_timeout",
        "A failed job is requeued when the same Idempotency-Key is retried"
      ]
    },
    {
      "dot": "amber",
      "title": "Solver output",
      "items": [
        "Cheapest allocation per item across the chosen suppliers, with single-supplier baselines",
        "Advanced jobs add supplier terms, risk limits and excluded suppliers",
        "Items without a usable offer are reported as infeasible"
      ]
    }
  ]
