  "cards": [
    {
      "dot": "cyan",
      "title": "Where the tenant comes from",
      "items": [
        "Only the signed tenant_id claim; never a path, query or header",
        "The hook runs on every issue and refresh, so a role change applies on the next refresh",
        "No active membership → no tenant claim → every policy denies"
      ]
    },
    {
      "dot": "rose",
      "title": "Enforced in the database",
      "items": [
        "Tenant tables enable and force row-level security keyed on current_tenant_id()",
        "The API queries with the member's own JWT, so PostgREST applies those policies",
        "A token whose tenant or role disagrees with the membership row is rejected with 401"
      ]
    }
  ]
