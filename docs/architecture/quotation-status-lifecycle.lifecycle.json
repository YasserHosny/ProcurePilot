  "cards": [
    {
      "dot": "amber",
      "title": "Email and capture start at Extracting",
      "items": [
        "They insert the quotation as Extracting with its extraction job, in one transaction",
        "If the job cannot be queued, it is marked failed and the quotation returns to Pending for POST /extract"
      ]
    },
    {
      "dot": "cyan",
      "title": "Confirm needs",
      "items": [
        "A supplier and an evidenced currency",
        "No unresolved low-confidence fields",
        "An acknowledged arithmetic mismatch, if there is one"
      ]
    },
    {
      "dot": "slate",
      "title": "Also",
      "items": [
        "Any reviewer edit on Extracted moves it to In review",
        "Retry or a replaced document is allowed from any state except Pending or Extracting",
        "Archiving sets deleted_at and resolves open review tasks; it is not a status"
      ]
    }
  ]
