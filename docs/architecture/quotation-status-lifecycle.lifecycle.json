  "cards": [
    {
      "dot": "amber",
      "title": "Email and capture skip Extracting",
      "items": [
        "They create the quotation and its extraction job together and stay Pending",
        "The worker then writes Extracted, In review or Refused straight from Pending"
      ]
    },
    {
      "dot": "cyan",
      "title": "Confirm needs",
      "items": [
        "A supplier and an evidenced currency",
        "No unresolved low-confidence fields",
        "An acknowledged arithmetic mismatch, if there is one"
      ]
    },
    {
      "dot": "slate",
      "title": "Also",
      "items": [
        "Extracted can be refused directly, like In review; any reviewer edit moves it to In review",
        "Retry or a replaced document is allowed from any state except Pending or Extracting",
        "Archiving sets deleted_at and resolves open review tasks; it is not a status"
      ]
    }
  ]
