    { "dot": "cyan", "title": "Who approves", "items": [
      "Narrowest matching threshold rule in the request's currency; branch rules beat tenant-wide",
      "An active delegation hands the step to the delegate",
      "No rule or no estimate → the workspace owner",
      "Removing the assigned approver escalates the pending step"
    ] },
    { "dot": "amber", "title": "Decision guarantees", "items": [
      "Request, step and push notification are written in one transaction",
      "Only the assigned approver or the owner can decide",
      "A concurrent withdrawal makes the decision fail with 409"
    ] },
