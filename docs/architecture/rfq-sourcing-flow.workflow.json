  "cards": [
    { "dot": "cyan", "title": "Reply attribution", "items": [
      "Direct In-Reply-To parent first, then newest same-supplier reference",
      "Ambiguous across suppliers → no rfq_response, normal cascade/review"
    ] },
    { "dot": "rose", "title": "Guardrail limits", "items": [
      "Waits until every non-refused response is reviewed and fully matched",
      "Checks min responses, max order value, price variance, supplier and category allowlists",
      "Uses the same prepare_request as the buyer, then emails the guardrail owner"
    ] },
    { "dot": "amber", "title": "Never autonomous purchasing", "items": [
      "Both paths stop at a draft request; a human submits it into approvals",
      "One request per RFQ: a second preparation sees converted and replays"
    ] }
