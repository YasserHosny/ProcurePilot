# ── Supabase ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=

# ── Redis / Queue ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
EXTRACTION_QUEUE_NAME=quotation-extraction

# ── Extraction Provider ───────────────────────────────────────
# "stub" = deterministic fake data (no credentials needed)
# "bedrock" = Claude via AWS Bedrock (primary), Azure DI fallback
# "azure_di" = Azure Document Intelligence only
EXTRACTION_PROVIDER_MODE=stub
EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# ── AWS Bedrock (when provider_mode = bedrock) ────────────────
# Option A: static credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Option B: SSO profile (run `aws sso login --profile <name>` first)
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=arn:aws:bedrock:us-east-1:524256002093:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0

# ── Azure Document Intelligence (fallback, or azure_di mode) ─
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
