# Clones, worktrees and CI do not download the demo videos unless asked:
#   git lfs install --local && git lfs pull --include="docs/gtm/video/**" --exclude=""
# (--exclude="" is needed: the fetchexclude below otherwise wins over --include)
# Where you edit the videos, opt out for good: git config lfs.fetchexclude ""
# (keeps the 10 GiB/month free LFS bandwidth for the people who watch or re-cut them).
[lfs]
	fetchexclude = docs/gtm/video/**
