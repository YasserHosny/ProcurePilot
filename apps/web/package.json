{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && node scripts/check-i18n-keys.mjs",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadless",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "docs:screenshots": "CAPTURE_USER_DOC_SCREENSHOTS=1 playwright test --config=playwright.docs.config.ts --project=chrome",
    "landing:screenshots": "playwright test --config=playwright.landing.config.ts --project=chrome"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "22.2.3",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@sentry/angular": "^11",
    "@supabase/supabase-js": "^2.105",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.6",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^9",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8"
  }
}
