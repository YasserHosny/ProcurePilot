{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && node scripts/check-i18n-keys.mjs",
    "test:unit": "ng test --watch=false --browsers=ChromeHeadless",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "docs:screenshots": "CAPTURE_USER_DOC_SCREENSHOTS=1 playwright test --config=playwright.docs.config.ts --project=chrome"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@ngx-translate/core": "^16.0.0",
    "@ngx-translate/http-loader": "^16.0.0",
    "@sentry/angular": "^9",
    "@supabase/supabase-js": "^2.105",
    "material-icons": "^1.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^3.23",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^19",
    "eslint": "^9",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8"
  }
}
