# ProcurePilot — configuration template.
# Copy to .env for local development. NEVER put real secrets in this file:
# it is committed, and a gitleaks scan blocks any PR that carries one (FR-027, SC-009).

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000
# One of: local | staging | production
# Keep comments on their own line: docker's --env-file reads everything after '=' as the
# value, inline comment included, and the app then rejects it as an invalid setting.
API_ENV=local
API_LOG_LEVEL=info
API_CORS_ORIGINS=http://localhost:4200

# ---------- Supabase (hosted project used by local dev) ----------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-hosted-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-hosted-service-role-key
SUPABASE_JWT_SECRET=replace-with-hosted-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# ---------- Database ----------
DATABASE_URL=postgresql://postgres:<password>@db.your-project-ref.supabase.co:5432/postgres

# ---------- Invitations ----------
PLATFORM_INVITATION_TTL_DAYS=7
MEMBER_INVITATION_TTL_DAYS=7

# ---------- Rate limiting (in-process; Redis deferred to chunk 4.3, research R7) ----------
RATE_LIMIT_AUTH=10/minute

# ---------- Quotation extraction (chunk 4.3) ----------
REDIS_URL=redis://localhost:6379/0
EXTRACTION_QUEUE_NAME=quotation-extraction
BASKET_SPLIT_QUEUE_NAME=basket-split
EXPORT_QUEUE_NAME=exports
# "bedrock" (Claude via AWS Bedrock, same as production) or "azure_di" (Azure Document
# Intelligence). There is no stub/mock mode — missing credentials fail the extraction job
# loudly instead of returning fake data.
EXTRACTION_PROVIDER_MODE=bedrock
EXTRACTION_CONFIDENCE_THRESHOLD=0.85
QUOTATION_DOCUMENTS_BUCKET=quotation-documents
SUPABASE_EXPORTS_BUCKET=exports
# Signed download-URL lifetime for completed export artifacts, in seconds (60-3600).
EXPORT_DOWNLOAD_URL_TTL_SECONDS=300

# ---------- AWS Bedrock (provider_mode = bedrock) ----------
# Option A: static credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
# Option B: SSO profile — run `aws sso login --profile <name>` first
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=arn:aws:bedrock:us-east-1:524256002093:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0

# ---------- Azure Document Intelligence (fallback, or provider_mode = azure_di) ----------
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# ---------- Product matching (chunk 4.4) ----------
MATCHING_AUTO_ACCEPT_THRESHOLD=0.9200
MATCHING_AUTO_REJECT_THRESHOLD=0.2500
MATCHING_REVIEW_MARGIN=0.0500
MATCHING_TRIGRAM_THRESHOLD=0.30
MATCHING_EMBEDDING_MODEL=stub-hash-v1

# ---------- Web ----------
WEB_API_BASE_URL=http://localhost:8000/api/v1
WEB_DEFAULT_LOCALE=en

# ---------- Observability ----------
SENTRY_DSN=
POSTHOG_API_KEY=

# ---------- Accounting integration (R3.1, 014-accounting-integration) ----------
# "stub" (default) keeps every endpoint fully testable without a real Intuit/QuickBooks
# developer account. "quickbooks" and "xero" require their provider values below.
ACCOUNTING_PROVIDER_MODE=stub
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
XERO_ENVIRONMENT=sandbox
# Fernet key (44-char urlsafe-base64, e.g. generated via
# `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
# encrypting access_token/refresh_token at rest. Required for accounting_provider_mode=quickbooks
# or xero against real, live tokens; optional in stub mode (T039 security review — see config.py).
ACCOUNTING_TOKEN_ENCRYPTION_KEY=
RATE_LIMIT_ACCOUNTING_SYNC=10/minute
RATE_LIMIT_ACCOUNTING_DISCREPANCY_RESOLVE=30/minute
