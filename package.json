{
  "name": "procurepilot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "supabase migration up --local",
    "db:seed": "uv run --project apps/api python apps/api/scripts/seed.py",
    "test:api": "uv run --project apps/api pytest",
    "test:web": "pnpm --filter web test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:isolation": "uv run --project apps/api pytest apps/api/tests/integration/test_tenant_isolation.py",
    "test:a11y": "pnpm --filter web test:e2e -- --grep @a11y",
    "lint:api": "uv run --project apps/api ruff check apps/api",
    "lint:web": "pnpm --filter web lint"
  },
  "devDependencies": {
    "turbo": "^2.4.0"
  }
}
